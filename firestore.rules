rules_version = '2';
// Võ Lâm Quyết Đấu
service cloud.firestore {
  match /databases/{database}/documents {
    // cloud saves: each player reads/writes only their own slots
    match /players/{uid}/slots/{slot} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && slot in ['0', '1', '2', '3', '4', '5']
        && request.resource.data.data is string
        && request.resource.data.data.size() < 400000;
    }
    // Tỉ Võ seasons (duel_2026w46 ...): everyone signed in can read the
    // shadows, each player writes only their own
    match /{coll}/{uid} {
      allow read: if request.auth != null && coll.matches('duel_[0-9]{4}w[0-9]{2}');
      allow delete: if request.auth != null && request.auth.uid == uid
        && coll.matches('duel_[0-9]{4}w[0-9]{2}');
      allow create, update: if request.auth != null && request.auth.uid == uid
        && coll.matches('duel_[0-9]{4}w[0-9]{2}')
        && goodDuel(request.resource.data);
    }
    function goodDuel(d) {
      return d.data is string && d.data.size() < 20000 && d.score is int
        && d.name is string && d.name.size() <= 24
        && d.level is int && d.power is int && okPower(d.level, d.power);
    }
    // Edited saves stay off the boards: power above Build.max_power(level)
    // = min(45 × level + 5200, 160 × level + 1900) is refused (the second line
    // keeps low levels honest: gear tier follows story progress).
    function okPower(level, power) {
      return level >= 1 && level <= 80 && power >= 0 && power <= 45 * level + 5200
        && power <= 160 * level + 1900;
    }
    // Boss Thế Giới: wb_<yyyymmdd>/{uid}_{slot} = that hero's damage today.
    // At most 4 tries a day (3 + 1 ad) and 50,000 damage a try; tries and
    // damage only grow. The pool = sum(dmg) of the day's collection.
    match /{coll}/{id} {
      allow read: if request.auth != null && coll.matches('wb_[0-9]{8}');
      allow delete: if request.auth != null && coll.matches('wb_[0-9]{8}') && myHero(id);
      allow create: if request.auth != null && coll.matches('wb_[0-9]{8}') && myHero(id)
        && goodWb(request.resource.data);
      allow update: if request.auth != null && coll.matches('wb_[0-9]{8}') && myHero(id)
        && goodWb(request.resource.data)
        && request.resource.data.tries >= resource.data.tries
        && request.resource.data.dmg >= resource.data.dmg;
    }
    function myHero(id) {
      return id in [request.auth.uid + '_0', request.auth.uid + '_1', request.auth.uid + '_2', request.auth.uid + '_3', request.auth.uid + '_4', request.auth.uid + '_5'];
    }
    function goodWb(d) {
      return d.keys().hasOnly(['name', 'sect', 'level', 'dmg', 'tries'])
        && d.name is string && d.name.size() <= 24 && d.sect is string && d.sect.size() <= 16
        && d.level is int && d.tries is int && d.tries >= 1 && d.tries <= 4
        && d.dmg is int && d.dmg >= 0 && d.dmg <= d.tries * 50000;
    }
    // tuning read by the game, written in the console (config/wboss {pool})
    match /config/{id} {
      allow read: if request.auth != null;
    }
    // Bảng xếp hạng: rank/{uid}_{slot}, readable by everyone signed in
    match /rank/{id} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null
        && id in [request.auth.uid + '_0', request.auth.uid + '_1', request.auth.uid + '_2', request.auth.uid + '_3', request.auth.uid + '_4', request.auth.uid + '_5'];
      allow create, update: if request.auth != null
        && id in [request.auth.uid + '_0', request.auth.uid + '_1', request.auth.uid + '_2', request.auth.uid + '_3', request.auth.uid + '_4', request.auth.uid + '_5']
        && goodRank(request.resource.data);
    }
    function goodRank(d) {
      // level >= 2: fresh throwaway heroes stay off the boards (Ranks.MIN_LEVEL)
      return d.name is string && d.name.size() <= 24 && d.sect is string
        && d.level is int && d.level >= 2 && d.power is int && d.tower is int && d.stars is int
        && okPower(d.level, d.power)
        && (!('title' in d) || (d.title is string && d.title.size() <= 24));
    }
    // Kênh Thế Giới: chat/{id} readable by everyone signed in; a message is
    // written together with chatlast/{uid} in one commit, and chatlast refuses
    // a new time within 20 s of the last, so nobody can post faster. Mute a
    // player by creating chatban/{uid} (any field) in the console.
    match /chat/{id} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'sect', 'level', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 120
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.sect is string && request.resource.data.sect.size() <= 16
        && request.resource.data.level is int
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/chatlast/$(request.auth.uid)).data.at == request.time
        && !exists(/databases/$(database)/documents/chatban/$(request.auth.uid));
    }
    match /chatlast/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
        && request.time > resource.data.at + duration.value(20, 's');
    }
    // new-player funnel counters: funnel/{step} {n}; anyone signed in may only
    // add exactly 1 (Funnel.gd, read with tools/funnel_report.mjs)
    match /funnel/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && id.matches('[a-z0-9_]{2,40}')
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
    }
    // reports: chatreport/{msgId}_{uid}, write-only, reviewed in the console
    match /chatreport/{id} {
      allow create: if request.auth != null
        && id.matches('[A-Za-z0-9]{1,40}_' + request.auth.uid)
        && request.resource.data.keys().hasOnly(['msg', 'who', 'name', 'text', 'by', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 120
        && request.resource.data.name is string && request.resource.data.name.size() <= 24;
    }
  }
}
