#!/usr/bin/env python
# Static library for iOS (see build.sh): scons platform=ios arch=arm64 target=template_release
env = SConscript("godot-cpp/SConstruct").Clone()
env.Append(CPPPATH=["src/"])
env.Append(CCFLAGS=["-fobjc-arc"])
lib = env.StaticLibrary("bin/libvlstorekit", ["src/vl_storekit.mm"])
Default(lib)
